# --- Server ---
PORT=4000
NODE_ENV=development

# Secret used to sign session (JWT) cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Database (Turso Cloud SQLite) ---
# Set BOTH vars to use Turso (recommended; the live/production target).
# Leave them commented out to use the local SQLite file (DB_PATH) instead.
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional local fallback if you want to test offline (ignored while TURSO_DATABASE_URL is set)
# DB_PATH=server/data/app.db

# Force the local DB_PATH file even when the Turso vars above are set.
# Required for tests — PowerShell 5.1 cannot override env vars with empty strings.
# DB_MODE=local

# --- CORS (only needed if the frontend is served from a different origin in development) ---
CLIENT_ORIGIN=http://localhost:5173
